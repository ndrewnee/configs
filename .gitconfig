[user]
	name = Andrew Nee
	email = ndrewnee@gmail.com
[core]
	excludesfile = /Users/ndrewnee/.gitignore_global
	quotepath = off
[diff]
	tool = vimdiff
[http]
	cookiefile = /Users/ndrewnee/.gitcookies
[includeIf "gitdir:~/Projects/haqqex/"]
    path = ~/Projects/haqqex/.gitconfig
[includeIf "gitdir:~/Projects/ksg/"]
    path = ~/Projects/ksg/.gitconfig
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[push]
	default = current
[branch]
	autoSetupMerge = false
